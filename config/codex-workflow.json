{
  "schemaVersion": 2,
  "scanBoundary": {
    "policyFiles": [
      ".codex/agents/README.md",
      ".codex/agents/content-ia-editor.toml",
      ".codex/agents/design-system-curator.toml",
      ".codex/agents/frontend-implementer.toml",
      ".codex/agents/obsidian-notes-pipeline.toml",
      ".codex/agents/project-architect.toml",
      ".codex/agents/qa-build-reviewer.toml",
      ".codex/config.toml",
      ".omo/rules/agent-policy.md",
      ".omo/rules/notes-publication.md",
      "AGENTS.md",
      "config/codex-model-registry.snapshot.json",
      "config/codex-skill-admission.json",
      "config/codex-workflow.json",
      "docs/AGENT_WORKFLOW.md",
      "docs/CODEX_AGENT_ROUTING.md",
      "docs/CODEX_MODEL_USAGE.md",
      "docs/CODEX_SCAN_BOUNDARY.md",
      "docs/MODEL_ROUTING_PORTABILITY.md"
    ],
    "workflowFiles": [
      ".gitignore",
      "package.json",
      "tests/codex-routing-cases.json",
      "tests/codex-routing-current-cases.json",
      "tests/codexRouting.eval.test.mjs",
      "tests/codexRouting.test.mjs",
      "tests/codexRulesValidator.test.mjs",
      "tools/codex-routing.mjs",
      "tools/validate-codex-rules.mjs"
    ],
    "excludedPrefixes": [
      ".astro/",
      ".codex/chrome-",
      ".codex/screenshots/",
      ".git/",
      ".omo/run-continuation/",
      ".opencode/",
      "dist/",
      "node_modules/"
    ],
    "excludedFiles": [
      ".env",
      "notes.publish.local.json"
    ]
  },
  "execution": {
    "maxConcurrentAgents": 3,
    "maxDelegationDepth": 1,
    "maxRetainedDiffWriters": 1,
    "defaultForkPolicy": "none",
    "maxTotalChildrenSoft": 6,
    "automaticRetryPerLane": 1,
    "requireResultAndDeliveryEvidence": true,
    "routeEnvelopeFields": [
      "owner",
      "phase",
      "level",
      "modelLane",
      "bindingState",
      "model",
      "reasoning",
      "contextTier",
      "contextMode",
      "runtimeConstraint",
      "attestationRequired",
      "authority",
      "requiredGate"
    ]
  },
  "ownership": {
    "architecture": "project_architect",
    "notes": "obsidian_notes_pipeline",
    "design": "design_system_curator",
    "content": "content_ia_editor",
    "frontend": "frontend_implementer",
    "qa": "qa_build_reviewer"
  },
  "routingInput": {
    "phases": ["explain", "execute", "discover", "decide", "implement", "qa"],
    "authorityStates": ["resolved", "unresolved"],
    "scopes": ["single", "domain", "cross-domain"],
    "ambiguity": ["low", "contained", "material"],
    "verification": ["direct", "semantic"],
    "workloads": ["small", "normal", "large"]
  },
  "capabilityLevels": {
    "L0": "Deterministic execution after semantic authority is resolved; bypass model selection",
    "L1": "Efficient bounded semantic assist with direct exact-answer verification",
    "L2": "Bounded reasoning and implementation under settled authority",
    "L3": "Engineering synthesis and ordinary semantic review",
    "L4": "High-judgment architecture, ambiguity, privacy, publication, and critical review",
    "L5": "Exceptional escalation only after a consequential L4 gap and comparative evidence"
  },
  "modelAdapter": {
    "L1": { "lane": "fast", "reasoning": "low", "enabled": true },
    "L2": { "lane": "fast", "reasoning": "medium", "enabled": true },
    "L3": { "lane": "standard", "reasoning": "medium", "enabled": true },
    "L4": { "lane": "deep", "reasoning": "high", "enabled": true },
    "L5": { "lane": "frontier", "reasoning": null, "enabled": false }
  },
  "contextTiers": {
    "C0": "Deterministic execution without model context",
    "C1": "Compact fresh packet",
    "C2": "Focused working set",
    "C3": "Extended cross-domain working set",
    "C4": "Long-context admission only; never automatic",
    "C5": "Durable multi-window continuity; explicit only"
  },
  "criticalRisks": [
    "architecture",
    "deployment",
    "privacy",
    "publication",
    "schema",
    "security"
  ]
}
