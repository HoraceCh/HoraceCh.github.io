---
import HeaderGlass from './HeaderGlass.astro';
import ThemeToggle from './ThemeToggle.astro';
import '../styles/header.css';
interface Props { homeV2?: boolean }
const { homeV2 = false } = Astro.props;
const links = [
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/notes/', label: 'Notes' },
  { href: '/resume/', label: 'Resume' },
];
const regions = [
  { href: '#recent-news', label: 'Recent News' },
  { href: '#selected-works', label: 'Selected Works' },
  { href: '#honors', label: 'Honors' },
];
const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(href);
---
<div class="header-frame">
  <header class="hc-header" data-header data-home-v2={homeV2 ? 'true' : undefined}>
    <div class="hc-header__bar">
      <HeaderGlass name="bar" />
      <a class="hc-header__brand" href="/" aria-label="Horace Chan — Home" data-astro-prefetch="hover">
        <img class="hc-header__mark-light" src="/brand/horace-refined/horace-mark-light.svg" width="32" height="32" alt="" />
        <img class="hc-header__mark-dark" src="/brand/horace-refined/horace-mark-dark.svg" width="32" height="32" alt="" />
      </a>
      <nav class="hc-header__desktop" aria-label="Main navigation">
        {links.map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined} data-astro-prefetch="hover">{link.label}</a>)}
      </nav>
      <div class="hc-header__actions">
        <a class="hc-header__search" href="/search/" data-search-trigger aria-label="Search" title="Search (Ctrl/Cmd+K)">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        </a>
        <ThemeToggle />
        <details class="hc-header__disclosure">
          <summary aria-controls="header-mobile-navigation">Menu <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor"><path d="m4 7 5 5 5-5" /></svg></summary>
          <nav id="header-mobile-navigation" class="hc-header__panel" aria-label="Mobile navigation">
            <HeaderGlass name="panel" />
            <div class="hc-header__panel-scroll">
            {links.map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}
            {homeV2 && <div class="hc-header__regions">{regions.map(link => <a href={link.href} data-header-region>{link.label}<span aria-hidden="true">↓</span></a>)}</div>}
            </div>
          </nav>
        </details>
      </div>
    </div>
  </header>
</div>
<script>
  import { installHeader } from '../scripts/header';
  import { installHeaderGlass } from '../scripts/headerGlass';
  document.querySelectorAll<HTMLElement>('[data-header]').forEach(header => { installHeaderGlass(header); installHeader(header); });
</script>
