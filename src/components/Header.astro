---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/notes/', label: 'Notes' },
  { href: '/links/', label: 'Links' },
  { href: '/resume/', label: 'Resume' },
  { href: '/contact/', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="site-header">
  <div class="header-brand-row">
    <a class="site-brand" href="/" data-astro-prefetch="hover">Horace Chan</a>
    <ThemeToggle />
  </div>
  <nav class="site-nav" aria-label="Main navigation">
    {
      links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined} data-astro-prefetch="hover">
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.site-nav');

  function revealNavLink(link: HTMLElement | null) {
    if (!link || !nav || nav.scrollWidth <= nav.clientWidth) return;

    const documentScroll = { left: window.scrollX, top: window.scrollY };
    link.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'nearest' });

    if (window.scrollX !== documentScroll.left || window.scrollY !== documentScroll.top) {
      window.scrollTo({ ...documentScroll, behavior: 'auto' });
    }
  }

  const scheduleAfterPaint = (callback: () => void) => {
    window.requestAnimationFrame(() => {
      window.requestAnimationFrame(callback);
    });
  };

  if (nav && nav.dataset.revealInitialized !== 'true') {
    nav.dataset.revealInitialized = 'true';
    nav.addEventListener('focusin', (event) => {
      revealNavLink((event.target as Element).closest<HTMLElement>('a'));
    });

    const currentLink = nav.querySelector<HTMLElement>('[aria-current="page"]');
    scheduleAfterPaint(() => revealNavLink(currentLink));
  }
</script>
