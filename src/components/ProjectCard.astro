---
import StatusBadge from './StatusBadge.astro';
import TagList from './TagList.astro';
import ProjectCardMedia from './projects/ProjectCardMedia.astro';
import type { ProjectMedia } from '../data/projectMedia';

interface ProjectLinks {
  github?: string;
  demo?: string;
  notes?: string;
}

interface Props {
  title: string;
  description: string;
  status: string;
  category: string;
  maturity?: string;
  tags: string[];
  href: string;
  links?: ProjectLinks;
  variant?: 'text' | 'browse-media';
  media?: ProjectMedia;
}

const { title, description, status, category, maturity, tags, href, links = {}, variant = 'text', media } = Astro.props;
const browseMedia = variant === 'browse-media' ? media : undefined;
const formatLabel = (value?: string) => value?.replace(/-/g, ' ');
const maturityLabel = formatLabel(maturity);
const showMaturity = maturityLabel && maturityLabel.toLowerCase() !== formatLabel(status)?.toLowerCase();
const visibleLinks = [
  links.github && { href: links.github, label: 'GitHub', external: true },
  links.demo && { href: links.demo, label: 'Demo', external: true },
  links.notes && { href: links.notes, label: 'Notes', external: false },
].filter(Boolean) as { href: string; label: string; external: boolean }[];
---

<article class="card project-card">
  <ProjectCardMedia media={browseMedia}>
    <h3 slot="title"><a href={href}>{title}</a></h3>
    <div slot="meta" class="card-meta">
      <StatusBadge status={status} />
      <span>{category}</span>
      {showMaturity && <span>{maturityLabel}</span>}
    </div>
    <p slot="description">{description}</p>
    {
      visibleLinks.length > 0 && (
        <div slot="links" class="card-links" aria-label={`${title} links`}>
          {visibleLinks.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      )
    }
    <TagList slot="tags" tags={tags} />
  </ProjectCardMedia>
</article>
