---
interface Props {
  tags: string[];
  linkBase?: string;
}

import { buildPublicTagConcepts } from '../utils/notes';
import { slugify } from '../utils/slugify';

const { tags, linkBase } = Astro.props;
const displayTags = linkBase === '/notes/tags'
  ? buildPublicTagConcepts(tags, slugify)
  : tags.map((tag) => ({ label: tag, slug: slugify(tag) }));
---

{
  displayTags.length > 0 && (
    <ul class="tag-list" aria-label="Tags">
      {displayTags.map((tag) => (
        <li>
          {linkBase ? <a href={`${linkBase}/${tag.slug}/`}>{tag.label}</a> : tag.label}
        </li>
      ))}
    </ul>
  )
}
