---
import Section from './HomeSection.astro';
import { projectHref, selectHomepageProjects } from '../../utils/projectPublication';
import type { ProjectPublicationModel } from '../../utils/projectPublication';
interface Props {
  readonly model: ProjectPublicationModel;
  readonly ids: readonly string[];
  readonly media: Readonly<Record<string, { readonly src: string; readonly alt: string; readonly width: number; readonly height: number; readonly srcset?: string }>>;
}
const { model, ids, media } = Astro.props;
const missingId = ids.find(id => !model.byId.has(id));
if (missingId) throw new Error(`Home Works references an unknown Project ID: ${missingId}`);
const projects = selectHomepageProjects(model, ids);
---
<Section id="selected-works" title="Selected Works." measure="wide">
  <ol class="works-index">{projects.map((project, index) => {
    const data = project.entry.data;
    const image = media[project.id];
    return <li>
      {image && <a class="project-image" href={projectHref(project)} aria-label={`View ${data.title}`}><img src={image.src} alt={image.alt} width={image.width} height={image.height} srcset={image.srcset} sizes="(max-width: 700px) 92vw, 600px" loading="lazy" decoding="async" /></a>}
      <div class="project-copy"><p class="project-meta"><span aria-hidden="true">{String(index + 1).padStart(2, '0')} · </span>{data.role && <span>{data.role} · </span>}{data.status.replaceAll('-', ' ')}</p>
        <h3><a href={projectHref(project)}>{data.title}</a></h3><p>{data.description}</p>{data.contribution && <p class="contribution">{data.contribution}</p>}
        <div class="project-actions"><a href={projectHref(project)}>View project <span aria-hidden="true">→</span></a>{data.links.github && <a href={data.links.github} target="_blank" rel="noopener noreferrer">Repository <span aria-hidden="true">↗</span></a>}</div>
      </div>
    </li>;
  })}</ol>
</Section>
<style>
  ol { list-style:none; padding:0; margin:0; }
  li { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr); gap:48px; padding-block:40px; border-block-end:1px solid var(--line); align-items:center; }
  .project-image { display:block; aspect-ratio:16 / 10; background:var(--surface); }
  img { display:block; width:100%; height:100%; object-fit:contain; }
  .project-copy { min-width:0; }
  h3 { color:var(--text); }
  .project-meta { font-size:.8125rem; color:var(--muted); text-transform:capitalize; }
  h3 { font-size:clamp(1.5rem,2.6vw,2rem); line-height:1.2; letter-spacing:-.035em; font-weight:650; margin:12px 0 20px; overflow-wrap:anywhere; }
  p { line-height:1.7; margin:0 0 16px; overflow-wrap:anywhere; }
  .contribution { color:var(--muted); font-size:.875rem; }
  .project-actions { display:flex; flex-wrap:wrap; gap:16px 28px; font-size:.875rem; padding-block-start:8px; }
  a { color:inherit; text-decoration:underline; text-underline-offset:.2em; }
  .project-image, h3 a { text-decoration:none; }
  a:focus-visible { outline:2px solid var(--text); outline-offset:4px; }
  @media(max-width:700px) { li { grid-template-columns:minmax(0,1fr); gap:24px; padding-block:32px; } }
</style>
