---
import type { ProjectMedia } from '../../data/projectMedia';

interface Props {
  media?: ProjectMedia;
}

const { media } = Astro.props;
---

{
  media ? (
    <div class="project-card-media">
      <div class="project-card-media-layout">
        <div class="project-card-media-copy">
          <slot name="title" />
          <slot name="meta" />
          <slot name="description" />
        </div>
        <div class="project-card-media-preview">
          <img
            src={media.src}
            srcset={media.srcset}
            sizes="auto, 360px"
            width={media.width}
            height={media.height}
            alt={media.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="project-card-media-bottom">
          <slot name="links" />
          <slot name="tags" />
        </div>
      </div>
    </div>
  ) : (
    <>
      <slot name="title" />
      <slot name="meta" />
      <slot name="description" />
      <slot name="links" />
      <slot name="tags" />
    </>
  )
}

<style is:global>
  .project-card-media {
    container-type: inline-size;
  }

  .project-card-media-layout {
    display: grid;
    gap: 0 24px;
  }

  .project-card-media-copy,
  .project-card-media-bottom {
    min-inline-size: 0;
  }

  .project-card-media-copy > p {
    margin-block-end: 12px;
  }

  .project-card-media-preview {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 3 / 2;
    max-block-size: 240px;
    margin-block-end: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
  }

  .project-card-media-preview img {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    color: var(--text);
  }

  @container (min-width: 42rem) {
    .project-card-media-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
    }

    .project-card-media-preview {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      margin: 0;
    }

    .project-card-media-bottom {
      grid-column: 1;
    }
  }
</style>
