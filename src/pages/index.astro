---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/EditorialHero.astro';
import News from '../components/home/RecentNews.astro';
import Works from '../components/home/SelectedWorks.astro';
import Honors from '../components/home/HonorsIndex.astro';
import Footer from '../components/home/EditorialFooter.astro';
import content from '../data/home-v2.json';
import { loadProjectPublicationModel } from '../utils/projectPublication';
import '../styles/home-v2.css';

const model = await loadProjectPublicationModel();
const media = {
  "robomaster-2026-engineering-robot": {
    "src": "/images/home/rm26-robot-1200.webp",
    "width": 1200,
    "height": 800,
    "alt": "RoboMaster 2026 engineering robot photographed with its chassis and arm visible.",
    "srcset": "/images/home/rm26-robot-480.webp 480w, /images/home/rm26-robot-768.webp 768w, /images/home/rm26-robot-1200.webp 1200w"
  },
  "ai-retrieval-tool": {
    "src": "/images/home/ai-retrieval-ui-1200.webp",
    "width": 1200,
    "height": 1311,
    "alt": "AI_RETRIEVAL_X interface showing research intent input, query controls and semantic map.",
    "srcset": "/images/home/ai-retrieval-ui-480.webp 480w, /images/home/ai-retrieval-ui-768.webp 768w, /images/home/ai-retrieval-ui-1200.webp 1200w"
  }
};
---
<Layout homeV2 title="Horace Chan" description="Mechanical Engineering student building and documenting robotics, Embodied AI, and AI-assisted research workflows.">
  <Hero portrait={{
    src: "/images/home/owner-approved-ink-portrait-768.webp",
    width: 768, height: 960,
    alt: "Horace Chan, owner-approved color ink portrait.",
    maskSrc: "/images/home/owner-approved-alpha-mask-768.webp",
    srcset: "/images/home/owner-approved-ink-portrait-480.webp 480w, /images/home/owner-approved-ink-portrait-768.webp 768w",
    sizes: "(max-width: 620px) 330px, 825px"
  }} />
  <News entries={content.news} />
  <Works model={model} ids={content.workIds} media={media} />
  <Honors entries={content.honors} />
  <Footer slot="footer" />
</Layout>
