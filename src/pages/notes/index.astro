---
import Layout from '../../layouts/Layout.astro';
import NoteModuleTree from '../../components/NoteModuleTree.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import {
  buildNoteModuleTree,
  flattenNoteModuleTree,
  isOrdinaryNote,
  isPublicBrowseNote,
} from '../../utils/noteModules';
import { loadNotePublicationModel, noteHref } from '../../utils/notePublication';

const model = await loadNotePublicationModel();
const notes = [...model.discoverable].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const publicBrowseNotes = notes.filter(isPublicBrowseNote);
const noteModules = buildNoteModuleTree(publicBrowseNotes);
const moduleNodes = flattenNoteModuleTree(noteModules);
const ordinaryNotes = publicBrowseNotes.filter(isOrdinaryNote);
const recentNotes = ordinaryNotes.slice(0, 5);
const visibleModules = moduleNodes.filter((module) => module.segments.length > 1);
const browsePaths = [
  { label: 'Categories', href: '/notes/explore/#categories', detail: 'Subject areas' },
  { label: 'Learning paths', href: '/notes/explore/#learning-paths', detail: 'Ordered study routes' },
  { label: 'Tags', href: '/notes/explore/#tags', detail: 'Specific concepts' },
  { label: 'Note types', href: '/notes/explore/#note-types', detail: 'Content formats' },
  { label: 'Statuses', href: '/notes/explore/#statuses', detail: 'Current maturity' },
];
---

<Layout title="Notes" description="Public learning notes organized by collections, modules, topics, and recent updates.">
  <section class="notes-hero">
    <p class="eyebrow">Notes</p>
    <h1>Learning Notes</h1>
    <p class="lead">
      Public notes from my learning and project work, organized as a knowledge map instead of a date-only blog archive.
    </p>
    <p>
      Current areas include programming fundamentals, CS fundamentals, robotics, Embodied AI, VLA models,
      mechanical design, control systems, and AI-assisted workflows. Some entries are working notes and may be incomplete.
    </p>
  </section>

  <section class="section notes-entry-points" aria-labelledby="start-here-title">
    <SectionHeading
      id="start-here-title"
      eyebrow="Start Here"
      title="Choose a Way In"
      description="Use the knowledge hierarchy for structured study or recent notes for current work."
    />
    <nav aria-label="Notes entry points">
      <ol class="notes-entry-list">
        <li>
          <a href="#collections">
            <span><strong>Collections</strong><small>Follow the primary subject hierarchy</small></span>
            <span class="notes-entry-count">{noteModules.length}</span>
          </a>
        </li>
        <li>
          <a href="#recent-notes">
            <span><strong>Recent notes</strong><small>Read the latest individual updates</small></span>
            <span class="notes-entry-count">{recentNotes.length}</span>
          </a>
        </li>
      </ol>
    </nav>
  </section>

  <section class="section notes-module-overview" id="collections">
    <SectionHeading
      eyebrow="Primary Structure"
      title="Collections"
      description="Broad subject areas provide the first level of the public knowledge map."
    />
    <NoteModuleTree
      nodes={noteModules}
      emptyMessage="No public collections are available yet."
      showChildren={false}
    />
    <p class="module-overview-link"><a href="/notes/collections/">Browse all collections</a></p>
  </section>

  <section class="section notes-module-directory" id="modules">
    <SectionHeading
      eyebrow="Second Level"
      title="Modules"
      description="Focused branches within collections, shown as paths rather than a second wall of cards."
    />
    {
      visibleModules.length > 0 ? (
        <ol class="module-directory-list" aria-label="Note modules">
          {visibleModules.map((module) => (
            <li>
              <a href={module.href}>
                <span>
                  <small>{module.segments.slice(0, -1).join(' / ')}</small>
                  <strong>{module.title}</strong>
                </span>
                <span class="module-directory-count">
                  {module.ordinaryNoteCount} note{module.ordinaryNoteCount === 1 ? '' : 's'}
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-state">No public modules are available yet.</p>
      )
    }
  </section>

  <section class="section recent-notes" id="recent-notes">
    <SectionHeading
      eyebrow="Updates"
      title="Recent Notes"
      description="Recently updated individual notes. This is an update feed, not the main structure of the notes system."
    />
    {
      recentNotes.length > 0 ? (
        <div class="compact-note-list" aria-label="Recently updated individual notes">
          {recentNotes.map((note) => (
            <a class="compact-note" href={noteHref(note)} data-astro-prefetch="hover">
              <span>{note.data.title}</span>
              <small>{note.data.category} / {note.data.status}</small>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">No recent individual notes yet.</p>
      )
    }
  </section>

  <section class="section browse-section">
    <SectionHeading
      eyebrow="Browse"
      title="Key Browse Paths"
      description="Taxonomy remains available as a secondary way to narrow the same public notes."
    />
    <nav aria-label="Secondary notes browse paths">
      <ul class="notes-browse-links">
        {browsePaths.map((path) => (
          <li><a href={path.href}><span>{path.label}</span><small>{path.detail}</small></a></li>
        ))}
      </ul>
    </nav>
    <div class="notes-search-entry" role="group" aria-labelledby="notes-search-title">
      <div>
        <strong id="notes-search-title">Search Notes</strong>
        <p id="notes-search-description">Search will be available in a later Notes update. Browse remains available now.</p>
      </div>
      <button type="button" disabled aria-describedby="notes-search-description">Search planned</button>
    </div>
    <p class="notes-explore-entry"><a href="/notes/explore/">Explore all browse paths</a></p>
    <div class="notes-archive-entry">
      <p><strong>Need the complete list?</strong> The archive keeps every public individual note in one static index.</p>
      <a href="/notes/archive/">Open the notes archive</a>
    </div>
  </section>
</Layout>
