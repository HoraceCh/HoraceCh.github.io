---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import TagList from '../../components/TagList.astro';
import { loadProjectPublicationModel } from '../../utils/projectPublication';

export async function getStaticPaths() {
  const projectModel = await loadProjectPublicationModel();
  return projectModel.routable.map((project) => ({
    params: { slug: project.slug },
    props: { project: project.entry },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const formatLabel = (value: string) => value.replace(/-/g, ' ');
const maturityLabel = formatLabel(project.data.maturity);
const showMaturity = maturityLabel.toLowerCase() !== formatLabel(project.data.status).toLowerCase();
const projectTools = project.data.tools.length > 0 ? project.data.tools : project.data.stack;
---

<Layout title={project.data.title} description={project.data.description}>
  <article class="article project-detail" data-pagefind-body>
    <p class="back-link" data-pagefind-ignore><a href="/projects/">Back to Projects</a></p>
    <h1 class="type-project-entity-title">{project.data.title}</h1>
    <div class="card-meta article-meta project-detail-state" data-pagefind-ignore>
      <StatusBadge status={project.data.status} />
      <span>{project.data.category}</span>
      {showMaturity && <span>{maturityLabel}</span>}
    </div>
    <p class="lead">{project.data.description}</p>
    {
      (project.data.links.github || project.data.links.demo || project.data.links.notes) && (
        <div class="link-row" data-pagefind-ignore>
          {project.data.links.github && (
            <a href={project.data.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          )}
          {project.data.links.demo && (
            <a href={project.data.links.demo} target="_blank" rel="noopener noreferrer">Demo</a>
          )}
          {project.data.links.notes && <a href={project.data.links.notes}>Related Notes</a>}
        </div>
      )
    }
    <div class="card-meta article-meta project-detail-context" data-pagefind-ignore>
      {project.data.role && <span>{project.data.role}</span>}
      {project.data.timeframe && <span>{project.data.timeframe}</span>}
      {projectTools.length > 0 && <span>Tools: {projectTools.join(', ')}</span>}
    </div>
    <div data-pagefind-ignore><TagList tags={project.data.tags} /></div>
    <Content />
  </article>
</Layout>
